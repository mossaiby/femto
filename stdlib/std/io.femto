import std::builtin;
import std::c;

extern "C" {
    printf :: (string8 fmt, ...) -> int32;
}

#export
print :: (string8 s) -> void {
    __builtin_print_str(s);
}

#export
println :: (string8 s) -> void {
    __builtin_print_str(s);
    __builtin_print_nl();
}

#export
print_int :: (int64 n) -> void {
    __builtin_print_int(n);
}

#export
println_int :: (int64 n) -> void {
    __builtin_print_int(n);
    __builtin_print_nl();
}

#export
print_int128 :: (int128 n) -> void {
    __builtin_print_int128(n);
}

#export
println_int128 :: (int128 n) -> void {
    __builtin_print_int128(n);
    __builtin_print_nl();
}

#export
print_float :: (float64 val) -> void {
    __builtin_print_float(val);
}

#export
println_float :: (float64 val) -> void {
    __builtin_print_float(val);
    __builtin_print_nl();
}

#export
println_empty :: () -> void {
    __builtin_print_nl();
}

#export
print_char :: (int32 c) -> void {
    __builtin_print_char(c);
}