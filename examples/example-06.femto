Point :: struct {
    int32 x = 0;
    int32 y = 0;
}

Color :: enum -> uint8 {
    red   = 1,
    green = 2,
    blue  = 3
}

// 1. Result type !int32 and failure/success/propagation
divide :: (int32 a, int32 b) -> !int32 {
    if (b == 0) then {
        return failure(101); // error code 101
    }
    return success(a / b);
}

calculate_ratio :: (int32 a, int32 b) -> !int32 {
    int32 val = divide(a, b)??; // propagates if failed
    return success(val * 2);
}

#export
test_error_handling :: () -> int32 {
    // Succeeded calculation: (100 / 5) * 2 = 40
    int32 ok_res = 0;
    calculate_ratio(100, 5)
        ?? (int32 val)  { ok_res = val; }
        :  (int32 code) { ok_res = -1; };

    // Failed calculation: 100 / 0 -> failure(101)
    int32 fail_code = 0;
    calculate_ratio(100, 0)
        ?? (int32 val)  { fail_code = 0; }
        :  (int32 code) { fail_code = code; };

    if (ok_res == 40 && fail_code == 101) then {
        return 1;
    }
    return 0;
}

// 2. Pattern Matching with #
#export
test_match :: (int32 c) -> int32 {
    int32 mapped = match (c) {
        # == 1 || # == 10 { 100 }
        # == 2            { 200 }
        # > 50            { 500 }
        default           { 999 }
    };
    return mapped;
}

// 3. Foreach loop on Arrays and Slices
#export
test_foreach :: () -> int32 {
    int32[4] numbers = [10, 20, 30, 40];
    int32 total = 0;

    foreach (int32 n in numbers) {
        total += n; // 10 + 20 + 30 + 40 = 100
    }

    int32 indexed_sum = 0;
    int32[] slice = numbers[1..3]; // [20, 30]
    foreach (int32 i, int32 val in slice) {
        indexed_sum += (i + 1) * val; // 1*20 + 2*30 = 20 + 60 = 80
    }

    return total + indexed_sum; // 100 + 80 = 180
}

#export
main :: () -> int32 {
    int32 t1 = test_error_handling(); // 1
    int32 m1 = test_match(10);        // 100
    int32 m2 = test_match(2);         // 200
    int32 m3 = test_match(75);        // 500
    int32 m4 = test_match(5);         // 999
    int32 t3 = test_foreach();        // 180

    if (t1 == 1 && m1 == 100 && m2 == 200 && m3 == 500 && m4 == 999 && t3 == 180) then {
        return 99; // All Phase 4 checks passed!
    } else {
        return 1;
    }
}