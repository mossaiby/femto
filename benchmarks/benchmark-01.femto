import std::io;
import std::c;

// 1. Floating-point Mandelbrot Escape-Time Kernel
#export
run_mandelbrot :: (int32 width, int32 height, int32 max_iter) -> int64 {
    int64 total_iterations = @cast(int64, 0);
    float64 f_width = @cast(float64, width);
    float64 f_height = @cast(float64, height);

    for (int32 y = 0; y < height; y++) {
        float64 cy = -1.5 + (3.0 * @cast(float64, y)) / f_height;
        for (int32 x = 0; x < width; x++) {
            float64 cx = -2.0 + (3.0 * @cast(float64, x)) / f_width;
            float64 zx = 0.0;
            float64 zy = 0.0;
            int32 iter = 0;

            while (zx * zx + zy * zy <= 4.0 && iter < max_iter) {
                float64 tmp = zx * zx - zy * zy + cx;
                zy = 2.0 * zx * zy + cy;
                zx = tmp;
                iter++;
            }
            total_iterations += @cast(int64, iter);
        }
    }
    return total_iterations;
}

// 2. Integer ALU & Branching Kernel
#export
run_collatz :: (int32 max_n) -> int64 {
    int64 total_steps = @cast(int64, 0);
    for (int32 i = 1; i <= max_n; i++) {
        int64 n = @cast(int64, i);
        int32 steps = 0;
        while (n > 1) {
            if (n % 2 == 0) then {
                n = n / 2;
            } else {
                n = n * 3 + 1;
            }
            steps++;
        }
        total_steps += @cast(int64, steps);
    }
    return total_steps;
}

#export
main :: () -> int32 {
    std::io::println("====================================================");
    std::io::println("           COMPUTE BENCHMARK: Femto Native          ");
    std::io::println("====================================================");

    // Benchmark 1: Mandelbrot
    std::io::println("[1/2] Running Mandelbrot (2000x2000, 250 max_iter)...");
    int64 t0 = std::c::clock();
    int64 mandel_checksum = run_mandelbrot(2000, 2000, 250);
    int64 t1 = std::c::clock();

    #if (@target == "x86_64-windows") {
        // Windows CLOCKS_PER_SEC is 1000
        float64 mandel_ms = @cast(float64, t1 - t0);
    } #else {
        // Linux CLOCKS_PER_SEC is 1,000,000
        float64 mandel_ms = @cast(float64, t1 - t0) / 1000.0;
    }
    std::io::println("      -> Checksum: {}", mandel_checksum);
    std::io::println("      -> Time    : {} ms\n", mandel_ms);

    // Benchmark 2: Collatz
    std::io::println("[2/2] Running Collatz Sequence (2,000,000 iterations)...");
    int64 t2 = std::c::clock();
    int64 collatz_checksum = run_collatz(2000000);
    int64 t3 = std::c::clock();

    #if (@target == "x86_64-windows") {
        float64 collatz_ms = @cast(float64, t3 - t2);
    } #else {
        float64 collatz_ms = @cast(float64, t3 - t2) / 1000.0;
    }
    std::io::println("      -> Checksum: {}", collatz_checksum);
    std::io::println("      -> Time    : {} ms\n", collatz_ms);

    float64 total_time = mandel_ms + collatz_ms;
    std::io::println("Total Execution Time: {} ms", total_time);
    std::io::println("====================================================");
    return 0;
}