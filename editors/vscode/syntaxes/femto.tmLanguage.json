{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Femto",
  "scopeName": "source.femto",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#directives" },
    { "include": "#arrow" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-results" },
    { "include": "#constants-language" },
    { "include": "#types-primitive" },
    { "include": "#function-declarations" },
    { "include": "#function-calls" },
    { "include": "#types-custom" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.femto",
          "match": "//.*$"
        },
        {
          "name": "comment.block.femto",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.femto",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.femto",
              "match": "\\\\([nrt0'\"\\\\]|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        },
        {
          "name": "string.quoted.raw.femto",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.femto",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.femto",
              "match": "\\\\([nrt0'\"\\\\]|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.femto",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.femto",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.femto",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.femto",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.femto",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.femto",
          "match": "@(sizeof|alignof|typeof|cast|bitcast|target|arch|endian|file|line)\\b"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.femto",
          "match": "#(export|if|else)\\b"
        },
        {
          "name": "variable.language.subject.femto",
          "match": "(?<=^|[\\s\\(\\[\\{,])#(?!export|if|else)\\b"
        }
      ]
    },
    "arrow": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.femto storage.type.function.arrow.femto",
          "match": "->"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.femto",
          "match": "\\b(if|then|else|while|do|for|switch|case|default|foreach|in|break|continue|return|match|defer)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.femto",
          "match": "\\b(struct|union|enum|import|namespace|extern|const|as)\\b"
        }
      ]
    },
    "keywords-results": {
      "patterns": [
        {
          "name": "support.function.result.femto",
          "match": "\\b(success|failure)\\b"
        }
      ]
    },
    "constants-language": {
      "patterns": [
        {
          "name": "constant.language.femto",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types-primitive": {
      "patterns": [
        {
          "name": "storage.type.primitive.femto",
          "match": "\\b(any|int8|int16|int32|int64|int128|int256|int512|uint8|uint16|uint32|uint64|uint128|uint256|uint512|float16|float32|float64|float128|bool8|bool16|bool32|bool64|bool128|bool256|bool512|char8|char16|char32|string8|string16|string32|void)\\b"
        }
      ]
    },
    "function-declarations": {
      "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(::)\\s*(?:(<[^>]+>)\\s*)?(\\()",
      "captures": {
        "1": { "name": "entity.name.function.femto" },
        "2": { "name": "keyword.operator.declaration.femto" },
        "3": { "name": "storage.type.generic.femto" },
        "4": { "name": "punctuation.definition.parameters.femto" }
      }
    },
    "function-calls": {
      "match": "([a-zA-Z_][a-zA-Z0-9_]*(?:::[a-zA-Z_][a-zA-Z0-9_]*)*)\\s*(?:(<[^>]+>)\\s*)?\\(",
      "captures": {
        "1": { "name": "entity.name.function.call.femto" },
        "2": { "name": "storage.type.generic.femto" }
      }
    },
    "types-custom": {
      "patterns": [
        {
          "name": "entity.name.type.femto",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.other.femto",
          "match": "\\b[A-Z0-9_]{2,}\\b(?=\\s*::)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.femto storage.type.function.arrow.femto",
          "match": "->"
        },
        {
          "name": "keyword.operator.result.femto",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.scope.femto",
          "match": "::"
        },
        {
          "name": "keyword.operator.ellipsis.femto",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.femto",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.compound.femto",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.increment.femto",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.comparison.femto",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.shift.femto",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.logical.femto",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.femto",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.femto",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.assignment.femto",
          "match": "="
        }
      ]
    }
  }
}