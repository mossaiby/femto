import std::c;

// Compile-Time Constants
PI   :: 3.141592653589793;
E    :: 2.718281828459045;
TAU  :: 6.283185307179586;

#export
abs :: (float64 x) -> float64 {
    if (x < 0.0) then {
        return -x;
    }
    return x;
}

#export
abs_int :: (int64 x) -> int64 {
    if (x < 0) then {
        return -x;
    }
    return x;
}

#export
min :: (float64 a, float64 b) -> float64 {
    if (a < b) then {
        return a;
    }
    return b;
}

#export
max :: (float64 a, float64 b) -> float64 {
    if (a > b) then {
        return a;
    }
    return b;
}

#export
min_int :: (int64 a, int64 b) -> int64 {
    if (a < b) then {
        return a;
    }
    return b;
}

#export
max_int :: (int64 a, int64 b) -> int64 {
    if (a > b) then {
        return a;
    }
    return b;
}

#export
clamp :: (float64 val, float64 low, float64 high) -> float64 {
    if (val < low) then {
        return low;
    }
    if (val > high) then {
        return high;
    }
    return val;
}

#export
clamp_int :: (int64 val, int64 low, int64 high) -> int64 {
    if (val < low) then {
        return low;
    }
    if (val > high) then {
        return high;
    }
    return val;
}

#export
sqrt :: (float64 x) -> float64 {
    return std::c::sqrt(x);
}

#export
pow :: (float64 base, float64 exp) -> float64 {
    return std::c::pow(base, exp);
}

#export
sin :: (float64 x) -> float64 {
    return std::c::sin(x);
}

#export
cos :: (float64 x) -> float64 {
    return std::c::cos(x);
}

#export
tan :: (float64 x) -> float64 {
    return std::c::tan(x);
}

#export
floor :: (float64 x) -> float64 {
    return std::c::floor(x);
}

#export
ceil :: (float64 x) -> float64 {
    return std::c::ceil(x);
}

#export
deg_to_rad :: (float64 deg) -> float64 {
    return deg * (PI / 180.0);
}

#export
rad_to_deg :: (float64 rad) -> float64 {
    return rad * (180.0 / PI);
}