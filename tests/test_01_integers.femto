// FILE: tests/test_01_integers.femto
// ============================================================================
import std::io;

#export
main :: () -> int32 {
    // 1. Basic 32-bit & 64-bit integer arithmetic
    int32 a = 100;
    int32 b = 25;
    int32 sum = a + b;      // 125
    int32 diff = a - b;     // 75
    int32 prod = a * b;     // 2500
    int32 quot = a / b;     // 4
    int32 rem = a % 30;     // 10

    // 2. Bitwise logic
    int32 bit_and = a & 7;  // 100 & 7 = 4
    int32 bit_or  = a | 3;  // 100 | 3 = 103
    int32 bit_xor = a ^ 15; // 100 ^ 15 = 107
    int32 bit_not = ~0;     // -1

    // 3. 128-bit arithmetic & comparisons
    int128 big1 = @cast(int128, 5000000000);
    int128 big2 = @cast(int128, 3000000000);
    int128 big_sum = big1 + big2;  // 8000000000
    int128 big_diff = big1 - big2; // 2000000000

    int32 cmp_ok = 0;
    if (big1 > big2 && big2 < big_sum && big_sum == @cast(int128, 8000000000)) then {
        cmp_ok = 1;
    }

    if (sum == 125 && diff == 75 && prod == 2500 && quot == 4 && rem == 10 &&
        bit_and == 4 && bit_or == 103 && bit_xor == 107 && bit_not == -1 &&
        big_diff == @cast(int128, 2000000000) && cmp_ok == 1) then {
        std::io::println("[PASS] test_01_integers");
        return 0;
    }
    return 1;
}