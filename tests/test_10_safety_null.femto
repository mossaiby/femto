// FILE: tests/test_10_safety_null.femto
// ============================================================================
import std::io;

Item :: struct {
    int32 id;
}

#export
main :: () -> int32 {
    // 1. const local variables
    const int32 MAX_COUNT = 500;
    const float64 RATE = 1.25;

    // 2. null pointer literal and comparison
    Item* ptr = null;
    int32 is_null = 0;
    if (ptr == null) then {
        is_null = 1;
    }

    Item item = { .id = 777 };
    ptr = &item;
    int32 not_null = 0;
    if (ptr != null) then {
        not_null = 1;
    }

    // 3. Safe array and slice indexing
    int32[4] arr = [10, 20, 30, 40];
    int32[] slice = arr[0..3]; // [10, 20, 30]

    int32 acc = slice[0] + slice[1] + slice[2]; // 60

    if (MAX_COUNT == 500 && RATE == 1.25 && is_null == 1 && not_null == 1 &&
        ptr.id == 777 && acc == 60) then {
        std::io::println("[PASS] test_10_safety_null");
        return 0;
    }
    return 1;
}